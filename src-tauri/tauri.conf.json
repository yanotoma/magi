{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magi",
  "version": "../package.json",
  "identifier": "dev.magi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Magi",
        "url": "/panel/",
        "width": 520,
        "height": 400,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": false,
        "windowEffects": {
          "effects": ["hudWindow"],
          "radius": 14,
          "state": "active"
        }
      },
      {
        "label": "settings",
        "title": "Magi Settings",
        "url": "/settings/",
        "width": 900,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "© 2026 The Magi contributors. Apache-2.0.",
    "shortDescription": "A background AI agent for your desktop",
    "longDescription": "Magi lives in your menu bar. Hold a hotkey and ask a question out loud, or type one; it transcribes on your Mac, reaches for your screen when a question needs to see it, and answers in a panel over whatever you were doing. Model-agnostic — bring your own, local or hosted.",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
